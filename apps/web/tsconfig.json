{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "dom", "dom.iterable"],
		"noEmit": true,
		"jsx": "preserve",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"]
		},
		"allowJs": true,
		"incremental": true
	},
	"include": ["*.ts", "*.tsx", "next-env.d.ts", "src", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
