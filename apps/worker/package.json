{
	"name": "worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit && node esbuild.config.mjs",
		"dev": "tsx watch --exclude \"node_modules/**\" --exclude \"../../node_modules/**\" src/index.ts",
		"purge:secrets": "tsx scripts/purge-runtime-secrets.ts",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"deploy:fly:example": "cd ../.. && fly deploy --config apps/worker/fly.toml --dockerfile apps/worker/Dockerfile"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.106.0",
		"@google/generative-ai": "^0.24.1",
		"@grammyjs/runner": "^2.0.3",
		"@grammyjs/storage-redis": "^2.5.1",
		"@hono/node-server": "2.0.10",
		"@repo/crypto": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/shared": "workspace:*",
		"@supabase/supabase-js": "^2.108.2",
		"big-integer": "^1.6.52",
		"bullmq": "^5.79.2",
		"density-clustering": "^1.3.0",
		"dotenv": "^17.4.2",
		"grammy": "^1.44.0",
		"hono": "4.12.27",
		"ioredis": "^5.11.1",
		"jose": "^6.2.3",
		"postgres": "^3.4.9",
		"posthog-node": "^5.38.8",
		"redlock": "5.0.0-beta.2",
		"telegram": "^2.26.22"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"esbuild": "^0.28.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	}
}
