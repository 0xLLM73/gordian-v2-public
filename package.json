{
	"name": "gordian-v2",
	"private": true,
	"license": "MIT",
	"packageManager": "pnpm@9.15.4",
	"scripts": {
		"audit:open-source": "node scripts/open-source-audit.mjs",
		"ai:egress:audit": "node scripts/ai-egress-inventory-audit.mjs",
		"build": "turbo build",
		"check:publication": "node scripts/check-publication-readiness.mjs",
		"bootstrap:local-owner": "tsx scripts/bootstrap-local-owner.ts",
		"db:migrate": "pnpm --filter @repo/db migrate",
		"dev": "turbo dev",
		"demo:guard": "node scripts/local-runtime-guard.mjs",
		"demo:infra": "docker compose up -d postgres redis",
		"demo:release-smoke": "tsx scripts/demo-smoke.ts --release",
		"demo:setup": "pnpm demo:guard && pnpm demo:infra && pnpm db:migrate && pnpm seed:demo",
		"demo:smoke": "tsx scripts/demo-smoke.ts",
		"kg:evidence:repair": "tsx scripts/knowledge-evidence-repair.ts",
		"kg:evidence:quality-audit": "tsx scripts/knowledge-evidence-quality-audit.ts",
		"kg:evidence:report": "tsx scripts/knowledge-evidence-report.ts",
		"kg:memory-message:backfill": "tsx scripts/knowledge-memory-message-backfill.ts",
		"kg:memory-message:report": "tsx scripts/knowledge-memory-message-backfill.ts",
		"kg:local:smoke": "node scripts/kg-local-smoke.mjs",
		"kg:model:eval": "tsx scripts/knowledge-model-eval.ts",
		"kg:recall:eval": "pnpm kg:recall:quality",
		"kg:recall:pg:smoke": "tsx scripts/knowledge-recall-pg-smoke.ts",
		"kg:recall:quality": "KG_RECALL_QUALITY_PRINT=1 pnpm --filter @repo/db test -- knowledge-recall-quality.test.ts --reporter=verbose",
		"kg:security:audit": "tsx scripts/knowledge-security-audit.ts",
		"keychain-helper:build": "node scripts/build-keychain-helper.mjs",
		"keychain-helper:doctor": "node scripts/keychain-helper-doctor.mjs",
		"keychain-helper:xcode-project": "node scripts/create-keychain-helper-xcode-project.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"local-ai:doctor": "node scripts/local-ai-doctor.mjs",
		"local-ai:benchmark": "node scripts/local-ai-benchmark.mjs",
		"local-ai:setup": "node scripts/local-ai-setup.mjs",
		"local-ai:setup:gemma": "node scripts/local-ai-setup.mjs --preset gemma",
		"local-ai:setup:nomic": "node scripts/local-ai-setup.mjs --preset nomic",
		"local-ai:setup:qwen": "node scripts/local-ai-setup.mjs --preset qwen",
		"messages:contact-linkage:audit": "tsx scripts/message-contact-linkage-audit.ts",
		"openai:setup": "node scripts/openai-setup.mjs",
		"purge:secrets": "pnpm --filter worker purge:secrets",
		"release:regression-guard": "node scripts/release-regression-guard.mjs",
		"seed:demo": "tsx scripts/seed.ts",
		"security:derived-data-audit": "tsx scripts/derived-data-security-audit.ts",
		"security:local-runtime-smoke": "node scripts/local-runtime-safety-smoke.mjs",
		"security:local-smoke": "pnpm security:local-runtime-smoke && pnpm telegram:security-smoke && pnpm security:derived-data-audit",
		"setup:local": "node scripts/local-setup.mjs",
		"telegram:api-keychain:harden": "node scripts/harden-telegram-api-keychain.mjs",
		"telegram:api-keychain:migrate": "node scripts/migrate-telegram-api-keychain.mjs",
		"telegram:keychain:harden": "tsx scripts/harden-telegram-keychain.ts",
		"telegram:doctor": "node scripts/telegram-doctor.mjs",
		"telegram:security-smoke": "node scripts/telegram-security-smoke.mjs",
		"telegram:setup": "node scripts/telegram-setup.mjs",
		"telegram:touchid:probe": "node scripts/telegram-touchid-probe.mjs",
		"workspace-key:migrate-local-keychain": "tsx scripts/migrate-workspace-keychain.ts",
		"test": "turbo test",
		"typecheck": "turbo typecheck"
	},
	"devDependencies": {
		"@aws-sdk/client-kms": "^3.1093.0",
		"@biomejs/biome": "^2.5.1",
		"tsx": "^4.23.1",
		"turbo": "2.10.6",
		"typescript": "^6.0.3",
		"vite": "8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@repo/crypto": "workspace:^",
		"@repo/db": "workspace:^",
		"@repo/shared": "workspace:^",
		"zod": "^4.4.3"
	},
	"pnpm": {
		"overrides": {
			"fast-xml-parser": ">=5.7.0",
			"rollup": ">=4.59.0",
			"minimatch": ">=10.2.3",
			"esbuild": ">=0.25.0",
			"protobufjs": "7.5.8",
			"fast-xml-builder": "1.1.7",
			"undici": "7.28.0",
			"postcss": ">=8.5.15",
			"dompurify": ">=3.4.11",
			"hono": "4.12.27",
			"kysely": "0.28.17",
			"lodash-es": ">=4.18.1",
			"ioredis": "5.11.1",
			"defu": ">=6.1.7",
			"vitest": "^4.1.10",
			"picomatch": ">=4.0.4",
			"ip-address": ">=10.1.1",
			"fast-uri@3.1.0": "3.1.2",
			"path-to-regexp@8.3.0": "8.4.0",
			"qs": "6.15.2",
			"brace-expansion": "5.0.6",
			"ws": "8.20.1",
			"express-rate-limit@8.2.1": "8.2.2"
		}
	}
}
