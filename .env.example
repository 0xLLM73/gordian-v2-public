# ============================================================
# Gordian v2 — Environment Variables
# See docs/ENVIRONMENT_MATRIX.md for full documentation
# Copy to .env.local and fill in values
# ============================================================

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/gordian_dev"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/gordian_dev"
POSTGRES_TEMP_FILE_LIMIT="256MB"

# --- Cache / Queue (DragonflyDB) ---
DRAGONFLY_URL="redis://127.0.0.1:6379"

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Internal Auth (Web ↔ Worker) ---
INTERNAL_AUTH_SECRET=""
WORKER_INTERNAL_SECRET=""
PHONE_REDIS_KEY_SECRET=""
ADMIN_AI_REPROCESS_CONFIRM_SECRET=""

# --- Worker ---
WORKER_URL="http://127.0.0.1:3001"
WORKER_HOST="127.0.0.1"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# --- Local demo ---
# Dev only. Lets seeded demo workspaces decrypt without AWS KMS.
DEV_KMS_BYPASS="true"
# Workspace data encryption. Use "os-keychain" for real local macOS workspaces so
# Postgres stores only a Keychain marker, not the workspace root key.
WORKSPACE_KEY_PROVIDER="dev-insecure"
WORKSPACE_KEYCHAIN_SERVICE="gordian-v2-workspace"
WORKSPACE_KEY_CACHE_TTL_MINUTES="60"
SEED_PASSWORD="gordian-demo"
NEXT_PUBLIC_DEMO_LOGIN_ENABLED="true"
NEXT_PUBLIC_DEMO_EMAIL="alice@gordian.dev"
NEXT_PUBLIC_DEMO_PASSWORD="gordian-demo"

# --- Telegram ---
# Disabled by default for open-source safety. Use a dedicated test Telegram app,
# bot, and account before setting any of these flags to "true".
TELEGRAM_BOT_ENABLED="false"
TELEGRAM_MTPROTO_ENABLED="false"
TELEGRAM_SEND_ENABLED="false"
TELEGRAM_FULL_BACKFILL_ENABLED="false"
TELEGRAM_PERIODIC_SYNC_ENABLED="false"
NEXT_PUBLIC_TELEGRAM_LINKING_ENABLED="false"
TELEGRAM_SESSION_KEY_PROVIDER="dev-insecure"
TELEGRAM_KEYCHAIN_SERVICE="gordian-v2-telegram"
TELEGRAM_KEYCHAIN_REQUIRE_USER_PRESENCE="false"
TELEGRAM_KEYCHAIN_USER_PRESENCE_MODE="compat"
GORDIAN_KEYCHAIN_HELPER_PATH=""
TELEGRAM_MTPROTO_PER_INTERACTION_UNLOCK="false"
TELEGRAM_MTPROTO_SESSION_IDLE_MINUTES="30"
TELEGRAM_ALLOW_SESSION_UNWRAP_OUTSIDE_IMPORTS="false"
TELEGRAM_RECENT_IMPORT_MAX_PAGES_PER_CHAT="1"
TELEGRAM_IMPORT_WORKER_LOCK_DURATION_MS="600000"
TELEGRAM_IMPORT_WORKER_STALLED_INTERVAL_MS="60000"
TELEGRAM_IMPORT_WORKER_MAX_STALLED_COUNT="2"
TELEGRAM_API_CREDENTIAL_PROVIDER="env"
TELEGRAM_API_KEYCHAIN_ACCOUNT="telegram-api-credentials"
BOT_TOKEN=""
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# --- AWS KMS ---
KMS_CMK_ARN=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Supabase (Realtime) ---
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# --- AI ---
AI_PROCESSING_ENABLED="false"
NEXT_PUBLIC_AI_PROCESSING_ENABLED="false"
NEXT_PUBLIC_LOCAL_AI_PROCESSING_ENABLED="false"
AI_SEARCH_EMBEDDINGS_ENABLED="false"
COMMITMENT_CLOUD_AI_ENABLED="true"
RATIONALE_CLOUD_AI_ENABLED="true"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY_PROVIDER="env"
OPENAI_API_KEY=""
OPENAI_KEYCHAIN_SERVICE="gordian-v2"
OPENAI_API_KEYCHAIN_ACCOUNT="openai-api-key"
GEMINI_API_KEY=""
KNOWLEDGE_EXTRACTION_ENABLED="false"
KNOWLEDGE_AUTO_ANALYSIS_ENABLED="false"
KNOWLEDGE_POST_SYNC_ANALYSIS_ENABLED="true"
KNOWLEDGE_SYNC_INCREMENTAL_DELAY_MS="90000"
KNOWLEDGE_SYNC_INCREMENTAL_CONTACT_LIMIT="50"
KNOWLEDGE_INCREMENTAL_MESSAGES_PER_CONTACT_LIMIT="200"
KNOWLEDGE_IMPORT_COMPLETION_DELAY_MS="5000"
KNOWLEDGE_IMPORT_INCREMENTAL_MESSAGE_THRESHOLD="100"
KNOWLEDGE_IMPORT_INCREMENTAL_CONTACT_LIMIT="50"
KNOWLEDGE_IMPORT_FULL_CONTACT_LIMIT="500"
KNOWLEDGE_IMPORT_FULL_MESSAGES_PER_CONTACT_LIMIT="200"
KNOWLEDGE_IMPORT_FULL_MAX_BATCHES="20"
KNOWLEDGE_IMPORT_FULL_CONTINUATION_DELAY_MS="1000"
KNOWLEDGE_ANALYSIS_WORKER_LOCK_DURATION_MS="1800000"
KNOWLEDGE_ANALYSIS_WORKER_STALLED_INTERVAL_MS="60000"
KNOWLEDGE_ANALYSIS_WORKER_MAX_STALLED_COUNT="2"
# KG local AI overrides. Defaults use cloud OpenAI embeddings and Gemini/Anthropic KG extraction.
# Set both providers to "local" for OpenAI-compatible local endpoints such as Ollama or LM Studio.
# Local AI endpoints must be loopback/private unless this explicit escape hatch is enabled.
ALLOW_NONLOCAL_AI_ENDPOINTS="false"
KNOWLEDGE_EMBEDDING_PROVIDER="openai"
KNOWLEDGE_EMBEDDING_PRESET="custom"
KNOWLEDGE_EMBEDDING_BASE_URL="https://api.openai.com/v1"
KNOWLEDGE_EMBEDDING_MODEL="text-embedding-3-small"
KNOWLEDGE_EMBEDDING_DIMENSIONS="512"
KNOWLEDGE_EMBEDDING_API_KEY=""
# Setup-managed compatibility marker. Leave blank unless local-ai:setup writes it.
KNOWLEDGE_EMBEDDING_FINGERPRINT=""
KNOWLEDGE_LLM_PROVIDER="auto"
KNOWLEDGE_LLM_BASE_URL="http://localhost:11434/v1"
KNOWLEDGE_LLM_MODEL="llama3.1:8b"
KNOWLEDGE_LLM_API_KEY=""
# Commitment extraction can use cloud Claude, native Ollama, or an OpenAI-compatible local chat model.
COMMITMENT_LLM_PROVIDER="cloud"
COMMITMENT_LLM_API="ollama"
COMMITMENT_LLM_BASE_URL="http://localhost:11434"
COMMITMENT_LLM_MODEL="qwen3.5:4b"
COMMITMENT_LLM_API_KEY=""
# Local model resource controls. Keep extraction at 1 for laptop-friendly Ollama runs.
AI_EXTRACTION_WORKER_CONCURRENCY="1"
LOCAL_AI_REQUEST_TIMEOUT_MS="120000"
LOCAL_AI_OLLAMA_KEEP_ALIVE="1m"
CHAT_LLM_PROVIDER="cloud"
CHAT_LLM_API="ollama"
CHAT_LLM_BASE_URL="http://localhost:11434"
CHAT_LLM_MODEL="qwen3.5:4b"
CHAT_LLM_API_KEY=""
DIGEST_LLM_PROVIDER="cloud"
DIGEST_LLM_API="ollama"
DIGEST_LLM_BASE_URL="http://localhost:11434"
DIGEST_LLM_MODEL="qwen3.5:4b"
DIGEST_LLM_API_KEY=""
DIGEST_CONTEXT_MESSAGE_BUDGET="240"
DIGEST_CONTEXT_PAGE_SIZE="20"
DIGEST_CONTEXT_MAX_CONTACTS="12"
DIGEST_CONTEXT_MESSAGES_PER_CONTACT="6"
DIGEST_BATCHING_ENABLED="true"
DIGEST_BATCH_MESSAGE_COUNT="60"
DIGEST_BATCH_MAX_BATCHES="12"
LOCAL_DIGEST_MAX_TOKENS="1536"
LOCAL_DIGEST_BATCH_MAX_TOKENS="768"
# Relationship scans default to one local job at a time. Raise cautiously on faster local hardware.
RELATIONSHIP_EXTRACTION_CONCURRENCY="1"
RELATIONSHIP_EXTRACTION_WORKER_LOCK_DURATION_MS="600000"
RELATIONSHIP_EXTRACTION_WORKER_STALLED_INTERVAL_MS="60000"
RELATIONSHIP_EXTRACTION_WORKER_MAX_STALLED_COUNT="2"

# --- Calendar (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OAUTH_STATE_SECRET=""

# --- Observability (optional) ---
HELICONE_ENABLED="false"
HELICONE_API_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
POSTHOG_API_KEY=""
POSTHOG_HOST=""
PROMPT_VERSION="v1"

# --- Runtime ---
NODE_ENV="development"
FEATURE_OUTCOME_SCORING="false"
